// firestore.rules
// ─────────────────────────────────────────────────────────
// Firestore Security Rules for BlackJack Score Keeper
//
// Design philosophy:
//   - Games are public within the app (no auth required)
//   - Anyone can create a game or join one
//   - Only writes that match the data model are allowed
//   - Games auto-expire via TTL (set in Firebase console)
// ─────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Games collection ──────────────────────────────────
    match /games/{sessionId} {

      // Anyone can read a game (to check it exists, phase, etc.)
      allow read: if true;

      // Anyone can create a game
      allow create: if
        request.resource.data.keys().hasAll(['name','startingBal','bankerBalance','currentRound','phase']) &&
        request.resource.data.startingBal is int &&
        request.resource.data.startingBal >= 10 &&
        request.resource.data.startingBal <= 100000 &&
        request.resource.data.phase == 'lobby';

      // Anyone with the session ID can update game state
      // (in a production app you'd add PIN validation server-side)
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['phase','currentRound','bankerBalance']);

      // ── Players subcollection ─────────────────────────────
      match /players/{playerId} {
        allow read:   if true;
        allow create: if
          request.resource.data.keys().hasAll(['name','balance','bet','betReady']) &&
          request.resource.data.name.size() >= 1 &&
          request.resource.data.name.size() <= 20;
        allow update: if
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['bet','betReady','balance','outcome']);
        allow delete: if false;
      }

      // ── Rounds subcollection ──────────────────────────────
      match /rounds/{roundId} {
        allow read:   if true;
        allow create: if
          request.resource.data.keys().hasAll(['round','entries']) &&
          request.resource.data.entries is list;
        allow update: if false; // rounds are immutable
        allow delete: if false;
      }
    }
  }
}
